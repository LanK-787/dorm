<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dorm.manage.mapper.DormRepairAssignmentMapper">
    
    <resultMap type="DormRepairAssignment" id="DormRepairAssignmentResult">
        <result property="assignmentId"    column="assignment_id"    />
        <result property="requestId"    column="request_id"    />
        <result property="requestNo"    column="request_no"    />
        <result property="repairerId"    column="repairer_id"    />
        <result property="repairerName"    column="repairer_name"    />
        <result property="specialty"    column="specialty"    />
        <result property="assignTime"    column="assign_time"    />
        <result property="processStatus"    column="process_status"    />
        <result property="acceptTime"    column="accept_time"    />
        <result property="completeTime"    column="complete_time"    />
        <result property="rejectTime"    column="reject_time"    />
        <result property="rejectReason"    column="reject_reason"    />
        <result property="processRemark"    column="process_remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectDormRepairAssignmentVo">
        select assignment_id, request_id, request_no, repairer_id, repairer_name, specialty, assign_time, process_status, accept_time, complete_time, reject_time, reject_reason, process_remark, create_by, create_time, update_by, update_time from dorm_repair_assignment
    </sql>

    <select id="selectDormRepairAssignmentList" parameterType="DormRepairAssignment" resultMap="DormRepairAssignmentResult">
        <include refid="selectDormRepairAssignmentVo"/>
        <where>  
            <if test="requestId != null "> and request_id = #{requestId}</if>
            <if test="requestNo != null  and requestNo != ''"> and request_no = #{requestNo}</if>
            <if test="repairerId != null "> and repairer_id = #{repairerId}</if>
            <if test="repairerName != null  and repairerName != ''"> and repairer_name like concat('%', #{repairerName}, '%')</if>
            <if test="specialty != null  and specialty != ''"> and specialty like concat('%', #{specialty}, '%')</if>
            <if test="assignTime != null "> and assign_time = #{assignTime}</if>
            <if test="processStatus != null  and processStatus != ''"> and process_status = #{processStatus}</if>
            <if test="acceptTime != null "> and accept_time = #{acceptTime}</if>
            <if test="completeTime != null "> and complete_time = #{completeTime}</if>
            <if test="rejectTime != null "> and reject_time = #{rejectTime}</if>
            <if test="rejectReason != null  and rejectReason != ''"> and reject_reason = #{rejectReason}</if>
            <if test="processRemark != null  and processRemark != ''"> and process_remark = #{processRemark}</if>
        </where>
    </select>
    
    <select id="selectDormRepairAssignmentByAssignmentId" parameterType="Long" resultMap="DormRepairAssignmentResult">
        <include refid="selectDormRepairAssignmentVo"/>
        where assignment_id = #{assignmentId}
    </select>

    <insert id="insertDormRepairAssignment" parameterType="DormRepairAssignment" useGeneratedKeys="true" keyProperty="assignmentId">
        insert into dorm_repair_assignment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="requestId != null">request_id,</if>
            <if test="requestNo != null and requestNo != ''">request_no,</if>
            <if test="repairerId != null">repairer_id,</if>
            <if test="repairerName != null and repairerName != ''">repairer_name,</if>
            <if test="specialty != null and specialty != ''">specialty,</if>
            <if test="assignTime != null">assign_time,</if>
            <if test="processStatus != null and processStatus != ''">process_status,</if>
            <if test="acceptTime != null">accept_time,</if>
            <if test="completeTime != null">complete_time,</if>
            <if test="rejectTime != null">reject_time,</if>
            <if test="rejectReason != null">reject_reason,</if>
            <if test="processRemark != null">process_remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="requestId != null">#{requestId},</if>
            <if test="requestNo != null and requestNo != ''">#{requestNo},</if>
            <if test="repairerId != null">#{repairerId},</if>
            <if test="repairerName != null and repairerName != ''">#{repairerName},</if>
            <if test="specialty != null and specialty != ''">#{specialty},</if>
            <if test="assignTime != null">#{assignTime},</if>
            <if test="processStatus != null and processStatus != ''">#{processStatus},</if>
            <if test="acceptTime != null">#{acceptTime},</if>
            <if test="completeTime != null">#{completeTime},</if>
            <if test="rejectTime != null">#{rejectTime},</if>
            <if test="rejectReason != null">#{rejectReason},</if>
            <if test="processRemark != null">#{processRemark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateDormRepairAssignment" parameterType="DormRepairAssignment">
        update dorm_repair_assignment
        <trim prefix="SET" suffixOverrides=",">
            <if test="requestId != null">request_id = #{requestId},</if>
            <if test="requestNo != null and requestNo != ''">request_no = #{requestNo},</if>
            <if test="repairerId != null">repairer_id = #{repairerId},</if>
            <if test="repairerName != null and repairerName != ''">repairer_name = #{repairerName},</if>
            <if test="specialty != null and specialty != ''">specialty = #{specialty},</if>
            <if test="assignTime != null">assign_time = #{assignTime},</if>
            <if test="processStatus != null and processStatus != ''">process_status = #{processStatus},</if>
            <if test="acceptTime != null">accept_time = #{acceptTime},</if>
            <if test="completeTime != null">complete_time = #{completeTime},</if>
            <if test="rejectTime != null">reject_time = #{rejectTime},</if>
            <if test="rejectReason != null">reject_reason = #{rejectReason},</if>
            <if test="processRemark != null">process_remark = #{processRemark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where assignment_id = #{assignmentId}
    </update>

    <delete id="deleteDormRepairAssignmentByAssignmentId" parameterType="Long">
        delete from dorm_repair_assignment where assignment_id = #{assignmentId}
    </delete>

    <delete id="deleteDormRepairAssignmentByAssignmentIds" parameterType="String">
        delete from dorm_repair_assignment where assignment_id in 
        <foreach item="assignmentId" collection="array" open="(" separator="," close=")">
            #{assignmentId}
        </foreach>
    </delete>
</mapper>