<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dorm.manage.mapper.DormRepairerMapper">
    
    <resultMap type="DormRepairer" id="DormRepairerResult">
        <result property="repairerId"    column="repairer_id"    />
        <result property="userId"    column="user_id"    />
        <result property="repairerNo"    column="repairer_no"    />
        <result property="name"    column="name"    />
        <result property="phone"    column="phone"    />
        <result property="specialty"    column="specialty"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectDormRepairerVo">
        select repairer_id, user_id, repairer_no, name, phone, specialty, status, create_by, create_time, update_by, update_time, remark from dorm_repairer
    </sql>

    <select id="selectDormRepairerList" parameterType="DormRepairer" resultMap="DormRepairerResult">
        <include refid="selectDormRepairerVo"/>
        <where>  
            <if test="repairerNo != null "> and repairer_no = #{repairerNo}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="specialty != null  and specialty != ''"> and specialty like concat('%', #{specialty}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectDormRepairerByRepairerId" parameterType="Long" resultMap="DormRepairerResult">
        <include refid="selectDormRepairerVo"/>
        where repairer_id = #{repairerId}
    </select>

    <select id="selectDormRepairerByUserId" parameterType="Long" resultMap="DormRepairerResult">
        <include refid="selectDormRepairerVo"/>
        where user_id = #{userId}
    </select>

    <insert id="insertDormRepairer" parameterType="DormRepairer" useGeneratedKeys="true" keyProperty="repairerId">
        insert into dorm_repairer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="repairerNo != null">repairer_no,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="specialty != null and specialty != ''">specialty,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="repairerNo != null">#{repairerNo},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="specialty != null and specialty != ''">#{specialty},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDormRepairer" parameterType="DormRepairer">
        update dorm_repairer
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="repairerNo != null">repairer_no = #{repairerNo},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="specialty != null and specialty != ''">specialty = #{specialty},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where repairer_id = #{repairerId}
    </update>

    <delete id="deleteDormRepairerByRepairerId" parameterType="Long">
        delete from dorm_repairer where repairer_id = #{repairerId}
    </delete>

    <delete id="deleteDormRepairerByRepairerIds" parameterType="String">
        delete from dorm_repairer where repairer_id in 
        <foreach item="repairerId" collection="array" open="(" separator="," close=")">
            #{repairerId}
        </foreach>
    </delete>
</mapper>