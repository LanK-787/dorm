<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dorm.manage.mapper.DormAlarmDeviceMapper">
    
    <resultMap type="DormAlarmDevice" id="DormAlarmDeviceResult">
        <result property="deviceId"    column="device_id"    />
        <result property="dormId"    column="dorm_id"    />
        <result property="deviceName"    column="device_name"    />
        <result property="deviceType"    column="device_type"    />
        <result property="location"    column="location"    />
        <result property="status"    column="status"    />
        <result property="lastOnlineTime"    column="last_online_time"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectDormAlarmDeviceVo">
        select device_id, dorm_id, device_name, device_type, location, status, last_online_time, create_time, update_time from dorm_alarm_device
    </sql>

    <select id="selectDormAlarmDeviceList" parameterType="DormAlarmDevice" resultMap="DormAlarmDeviceResult">
        <include refid="selectDormAlarmDeviceVo"/>
        <where>  
            <if test="dormId != null "> and dorm_id = #{dormId}</if>
            <if test="deviceName != null  and deviceName != ''"> and device_name like concat('%', #{deviceName}, '%')</if>
            <if test="deviceType != null "> and device_type = #{deviceType}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="lastOnlineTime != null "> and last_online_time = #{lastOnlineTime}</if>
        </where>
    </select>
    
    <select id="selectDormAlarmDeviceByDeviceId" parameterType="Long" resultMap="DormAlarmDeviceResult">
        <include refid="selectDormAlarmDeviceVo"/>
        where device_id = #{deviceId}
    </select>

    <insert id="insertDormAlarmDevice" parameterType="DormAlarmDevice" useGeneratedKeys="true" keyProperty="deviceId">
        insert into dorm_alarm_device
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dormId != null">dorm_id,</if>
            <if test="deviceName != null and deviceName != ''">device_name,</if>
            <if test="deviceType != null">device_type,</if>
            <if test="location != null">location,</if>
            <if test="status != null">status,</if>
            <if test="lastOnlineTime != null">last_online_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="dormId != null">#{dormId},</if>
            <if test="deviceName != null and deviceName != ''">#{deviceName},</if>
            <if test="deviceType != null">#{deviceType},</if>
            <if test="location != null">#{location},</if>
            <if test="status != null">#{status},</if>
            <if test="lastOnlineTime != null">#{lastOnlineTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateDormAlarmDevice" parameterType="DormAlarmDevice">
        update dorm_alarm_device
        <trim prefix="SET" suffixOverrides=",">
            <if test="dormId != null">dorm_id = #{dormId},</if>
            <if test="deviceName != null and deviceName != ''">device_name = #{deviceName},</if>
            <if test="deviceType != null">device_type = #{deviceType},</if>
            <if test="location != null">location = #{location},</if>
            <if test="status != null">status = #{status},</if>
            <if test="lastOnlineTime != null">last_online_time = #{lastOnlineTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where device_id = #{deviceId}
    </update>

    <delete id="deleteDormAlarmDeviceByDeviceId" parameterType="Long">
        delete from dorm_alarm_device where device_id = #{deviceId}
    </delete>

    <delete id="deleteDormAlarmDeviceByDeviceIds" parameterType="String">
        delete from dorm_alarm_device where device_id in 
        <foreach item="deviceId" collection="array" open="(" separator="," close=")">
            #{deviceId}
        </foreach>
    </delete>
</mapper>