<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dorm.manage.mapper.DormAlarmLogMapper">
    
    <resultMap type="DormAlarmLog" id="DormAlarmLogResult">
        <result property="alarmId"    column="alarm_id"    />
        <result property="deviceId"    column="device_id"    />
        <result property="dormId"    column="dorm_id"    />
        <result property="dormFullName"    column="dorm_full_name"    />
        <result property="smokeValue"    column="smoke_value"    />
        <result property="alarmLevel"    column="alarm_level"    />
        <result property="alarmTime"    column="alarm_time"    />
        <result property="handled"    column="handled"    />
        <result property="handledTime"    column="handled_time"    />
        <result property="handler"    column="handler"    />
        <result property="remarks"    column="remarks"    />
    </resultMap>

    <sql id="selectDormAlarmLogVo">
        select a.alarm_id, a.device_id, a.dorm_id, b.full_name as dorm_full_name, a.smoke_value, a.alarm_level, a.alarm_time, a.handled, a.handled_time, a.handler, a.remarks 
        from dorm_alarm_log a
        left join dorm_building b on a.dorm_id = b.dorm_id
    </sql>

    <select id="selectDormAlarmLogList" parameterType="DormAlarmLog" resultMap="DormAlarmLogResult">
        <include refid="selectDormAlarmLogVo"/>
        <where>
            <if test="deviceId != null "> and a.device_id = #{deviceId}</if>
            <if test="dormId != null "> and a.dorm_id = #{dormId}</if>
            <if test="dormIds != null and dormIds.size() > 0">
                and a.dorm_id in
                <foreach item="dormId" collection="dormIds" open="(" separator="," close=")">
                    #{dormId}
                </foreach>
            </if>
            <if test="smokeValue != null "> and a.smoke_value = #{smokeValue}</if>
            <if test="alarmLevel != null "> and a.alarm_level = #{alarmLevel}</if>
            <if test="alarmTime != null "> and a.alarm_time = #{alarmTime}</if>
            <if test="handled != null "> and a.handled = #{handled}</if>
            <if test="handledTime != null "> and a.handled_time = #{handledTime}</if>
            <if test="remarks != null  and remarks != ''"> and a.remarks = #{remarks}</if>
        </where>
        order by a.alarm_time desc
    </select>
    
    <select id="selectDormAlarmLogByAlarmId" parameterType="Long" resultMap="DormAlarmLogResult">
        <include refid="selectDormAlarmLogVo"/>
        where a.alarm_id = #{alarmId}
    </select>

    <insert id="insertDormAlarmLog" parameterType="DormAlarmLog" useGeneratedKeys="true" keyProperty="alarmId">
        insert into dorm_alarm_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">device_id,</if>
            <if test="dormId != null">dorm_id,</if>
            <if test="smokeValue != null">smoke_value,</if>
            <if test="alarmLevel != null">alarm_level,</if>
            <if test="alarmTime != null">alarm_time,</if>
            <if test="handled != null">handled,</if>
            <if test="handledTime != null">handled_time,</if>
            <if test="handler != null">handler,</if>
            <if test="remarks != null">remarks,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">#{deviceId},</if>
            <if test="dormId != null">#{dormId},</if>
            <if test="smokeValue != null">#{smokeValue},</if>
            <if test="alarmLevel != null">#{alarmLevel},</if>
            <if test="alarmTime != null">#{alarmTime},</if>
            <if test="handled != null">#{handled},</if>
            <if test="handledTime != null">#{handledTime},</if>
            <if test="handler != null">#{handler},</if>
            <if test="remarks != null">#{remarks},</if>
         </trim>
    </insert>

    <update id="updateDormAlarmLog" parameterType="DormAlarmLog">
        update dorm_alarm_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="dormId != null">dorm_id = #{dormId},</if>
            <if test="smokeValue != null">smoke_value = #{smokeValue},</if>
            <if test="alarmLevel != null">alarm_level = #{alarmLevel},</if>
            <if test="alarmTime != null">alarm_time = #{alarmTime},</if>
            <if test="handled != null">handled = #{handled},</if>
            <if test="handledTime != null">handled_time = #{handledTime},</if>
            <if test="handler != null">handler = #{handler},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
        </trim>
        where alarm_id = #{alarmId}
    </update>

    <delete id="deleteDormAlarmLogByAlarmId" parameterType="Long">
        delete from dorm_alarm_log where alarm_id = #{alarmId}
    </delete>

    <delete id="deleteDormAlarmLogByAlarmIds" parameterType="String">
        delete from dorm_alarm_log where alarm_id in 
        <foreach item="alarmId" collection="array" open="(" separator="," close=")">
            #{alarmId}
        </foreach>
    </delete>
</mapper>