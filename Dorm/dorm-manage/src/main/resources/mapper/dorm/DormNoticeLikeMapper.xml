<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dorm.manage.mapper.DormNoticeLikeMapper">
    
    <resultMap type="DormNoticeLike" id="DormNoticeLikeResult">
        <result property="id"    column="id"    />
        <result property="noticeId"    column="notice_id"    />
        <result property="userId"    column="user_id"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectDormNoticeLikeVo">
        select id, notice_id, user_id, create_time from dorm_notice_like
    </sql>

    <select id="selectDormNoticeLikeList" parameterType="DormNoticeLike" resultMap="DormNoticeLikeResult">
        <include refid="selectDormNoticeLikeVo"/>
        <where>  
            <if test="noticeId != null "> and notice_id = #{noticeId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
        </where>
    </select>
    
    <select id="selectDormNoticeLikeById" parameterType="Long" resultMap="DormNoticeLikeResult">
        <include refid="selectDormNoticeLikeVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertDormNoticeLike" parameterType="DormNoticeLike" useGeneratedKeys="true" keyProperty="id">
        insert into dorm_notice_like
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="noticeId != null">notice_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="noticeId != null">#{noticeId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateDormNoticeLike" parameterType="DormNoticeLike">
        update dorm_notice_like
        <trim prefix="SET" suffixOverrides=",">
            <if test="noticeId != null">notice_id = #{noticeId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDormNoticeLikeById" parameterType="Long">
        delete from dorm_notice_like where id = #{id}
    </delete>

    <delete id="deleteDormNoticeLikeByIds" parameterType="String">
        delete from dorm_notice_like where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 查询用户是否已对公告点赞 -->
    <select id="selectUserLikeRecord" resultMap="DormNoticeLikeResult">
        <include refid="selectDormNoticeLikeVo"/>
        where notice_id = #{noticeId} and user_id = #{userId}
    </select>

    <!-- 删除用户对公告的点赞记录 -->
    <delete id="deleteUserLikeRecord">
        delete from dorm_notice_like 
        where notice_id = #{noticeId} and user_id = #{userId}
    </delete>

    <!-- 统计公告的点赞数量 -->
    <select id="countLikesByNoticeId" resultType="int">
        select count(*) from dorm_notice_like where notice_id = #{noticeId}
    </select>

</mapper>
