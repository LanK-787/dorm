<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dorm.manage.mapper.DormStudentLeaveMapper">
    
    <resultMap type="DormStudentLeave" id="DormStudentLeaveResult">
        <result property="leaveId"    column="leave_id"    />
        <result property="studentNo"    column="student_no"    />
        <result property="leaveTime"    column="leave_time"    />
        <result property="expectedReturnTime"    column="expected_return_time"    />
        <result property="actualReturnTime"    column="actual_return_time"    />
        <result property="leaveReason"    column="leave_reason"    />
        <result property="destination"    column="destination"    />
        <result property="contactDuringLeave"    column="contact_during_leave"    />
        <result property="emergencyContact"    column="emergency_contact"    />
        <result property="emergencyPhone"    column="emergency_phone"    />
        <result property="status"    column="status"    />
        <result property="approver"    column="approver"    />
        <result property="approveTime"    column="approve_time"    />
        <result property="approveStatus"    column="approve_status"    />
        <result property="approveRemark"    column="approve_remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectDormStudentLeaveVo">
        select leave_id, student_no, leave_time, expected_return_time, actual_return_time, leave_reason, destination, contact_during_leave, emergency_contact, emergency_phone, status, approver, approve_time, approve_status, approve_remark, create_by, create_time, update_by, update_time, remark from dorm_student_leave
    </sql>

    <select id="selectDormStudentLeaveList" parameterType="DormStudentLeave" resultMap="DormStudentLeaveResult">
        <include refid="selectDormStudentLeaveVo"/>
        <where>
            <if test="studentNo != null "> and student_no = #{studentNo}</if>
            <if test="leaveTime != null "> and leave_time = #{leaveTime}</if>
            <if test="expectedReturnTime != null "> and expected_return_time = #{expectedReturnTime}</if>
            <if test="actualReturnTime != null "> and actual_return_time = #{actualReturnTime}</if>
            <if test="leaveReason != null  and leaveReason != ''"> and leave_reason = #{leaveReason}</if>
            <if test="destination != null  and destination != ''"> and destination = #{destination}</if>
            <if test="contactDuringLeave != null  and contactDuringLeave != ''"> and contact_during_leave = #{contactDuringLeave}</if>
            <if test="emergencyContact != null  and emergencyContact != ''"> and emergency_contact = #{emergencyContact}</if>
            <if test="emergencyPhone != null  and emergencyPhone != ''"> and emergency_phone = #{emergencyPhone}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="approver != null  and approver != ''"> and approver = #{approver}</if>
            <if test="approveTime != null "> and approve_time = #{approveTime}</if>
            <if test="approveStatus != null  and approveStatus != ''"> and approve_status = #{approveStatus}</if>
        </where>
        ORDER BY create_time DESC
    </select>
    
    <select id="selectDormStudentLeaveByLeaveId" parameterType="Long" resultMap="DormStudentLeaveResult">
        <include refid="selectDormStudentLeaveVo"/>
        where leave_id = #{leaveId}
    </select>

    <insert id="insertDormStudentLeave" parameterType="DormStudentLeave" useGeneratedKeys="true" keyProperty="leaveId">
        insert into dorm_student_leave
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="studentNo != null">student_no,</if>
            <if test="leaveTime != null">leave_time,</if>
            <if test="expectedReturnTime != null">expected_return_time,</if>
            <if test="actualReturnTime != null">actual_return_time,</if>
            <if test="leaveReason != null and leaveReason != ''">leave_reason,</if>
            <if test="destination != null">destination,</if>
            <if test="contactDuringLeave != null">contact_during_leave,</if>
            <if test="emergencyContact != null">emergency_contact,</if>
            <if test="emergencyPhone != null">emergency_phone,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="approver != null">approver,</if>
            <if test="approveTime != null">approve_time,</if>
            <if test="approveStatus != null and approveStatus != ''">approve_status,</if>
            <if test="approveRemark != null">approve_remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="studentNo != null">#{studentNo},</if>
            <if test="leaveTime != null">#{leaveTime},</if>
            <if test="expectedReturnTime != null">#{expectedReturnTime},</if>
            <if test="actualReturnTime != null">#{actualReturnTime},</if>
            <if test="leaveReason != null and leaveReason != ''">#{leaveReason},</if>
            <if test="destination != null">#{destination},</if>
            <if test="contactDuringLeave != null">#{contactDuringLeave},</if>
            <if test="emergencyContact != null">#{emergencyContact},</if>
            <if test="emergencyPhone != null">#{emergencyPhone},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="approver != null">#{approver},</if>
            <if test="approveTime != null">#{approveTime},</if>
            <if test="approveStatus != null and approveStatus != ''">#{approveStatus},</if>
            <if test="approveRemark != null">#{approveRemark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDormStudentLeave" parameterType="DormStudentLeave">
        update dorm_student_leave
        <trim prefix="SET" suffixOverrides=",">
            <if test="studentNo != null">student_no = #{studentNo},</if>
            <if test="leaveTime != null">leave_time = #{leaveTime},</if>
            <if test="expectedReturnTime != null">expected_return_time = #{expectedReturnTime},</if>
            <if test="actualReturnTime != null">actual_return_time = #{actualReturnTime},</if>
            <if test="leaveReason != null and leaveReason != ''">leave_reason = #{leaveReason},</if>
            <if test="destination != null">destination = #{destination},</if>
            <if test="contactDuringLeave != null">contact_during_leave = #{contactDuringLeave},</if>
            <if test="emergencyContact != null">emergency_contact = #{emergencyContact},</if>
            <if test="emergencyPhone != null">emergency_phone = #{emergencyPhone},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="approver != null">approver = #{approver},</if>
            <if test="approveTime != null">approve_time = #{approveTime},</if>
            <if test="approveStatus != null and approveStatus != ''">approve_status = #{approveStatus},</if>
            <if test="approveRemark != null">approve_remark = #{approveRemark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where leave_id = #{leaveId}
    </update>

    <delete id="deleteDormStudentLeaveByLeaveId" parameterType="Long">
        delete from dorm_student_leave where leave_id = #{leaveId}
    </delete>

    <delete id="deleteDormStudentLeaveByLeaveIds" parameterType="String">
        delete from dorm_student_leave where leave_id in 
        <foreach item="leaveId" collection="array" open="(" separator="," close=")">
            #{leaveId}
        </foreach>
    </delete>
</mapper>