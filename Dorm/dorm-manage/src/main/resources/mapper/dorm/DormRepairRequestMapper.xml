<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dorm.manage.mapper.DormRepairRequestMapper">
    
    <resultMap type="DormRepairRequest" id="DormRepairRequestResult">
        <result property="requestId"    column="request_id"    />
        <result property="requestNo"    column="request_no"    />
        <result property="studentId"    column="student_id"    />
        <result property="dormId"    column="dorm_id"    />
        <result property="specialty"    column="specialty"    />
        <result property="description"    column="description"    />
        <result property="reporterName"    column="reporter_name"    />
        <result property="contactPhone"    column="contact_phone"    />
        <result property="images"    column="images"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectDormRepairRequestVo">
        select request_id, request_no, student_id, dorm_id, specialty, description, reporter_name, contact_phone, images, status, create_by, create_time, update_by, update_time, remark from dorm_repair_request
    </sql>

    <select id="selectDormRepairRequestList" parameterType="DormRepairRequest" resultMap="DormRepairRequestResult">
        <include refid="selectDormRepairRequestVo"/>
        <where>  
            <if test="requestNo != null  and requestNo != ''"> and request_no = #{requestNo}</if>
            <if test="studentId != null "> and student_id = #{studentId}</if>
            <if test="dormId != null "> and dorm_id = #{dormId}</if>
            <if test="specialty != null  and specialty != ''"> and specialty = #{specialty}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="reporterName != null  and reporterName != ''"> and reporter_name like concat('%', #{reporterName}, '%')</if>
            <if test="contactPhone != null  and contactPhone != ''"> and contact_phone = #{contactPhone}</if>
            <if test="images != null  and images != ''"> and images = #{images}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="createTime != null "> and create_time = #{createTime}</if>
            <if test="updateTime != null "> and update_time = #{updateTime}</if>
        </where>
    </select>
    
    <select id="selectDormRepairRequestByRequestId" parameterType="Long" resultMap="DormRepairRequestResult">
        <include refid="selectDormRepairRequestVo"/>
        where request_id = #{requestId}
    </select>

    <insert id="insertDormRepairRequest" parameterType="DormRepairRequest" useGeneratedKeys="true" keyProperty="requestId">
        insert into dorm_repair_request
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="requestNo != null and requestNo != ''">request_no,</if>
            <if test="studentId != null">student_id,</if>
            <if test="dormId != null">dorm_id,</if>
            <if test="specialty != null and specialty != ''">specialty,</if>
            <if test="description != null">description,</if>
            <if test="reporterName != null and reporterName != ''">reporter_name,</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone,</if>
            <if test="images != null">images,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="requestNo != null and requestNo != ''">#{requestNo},</if>
            <if test="studentId != null">#{studentId},</if>
            <if test="dormId != null">#{dormId},</if>
            <if test="specialty != null and specialty != ''">#{specialty},</if>
            <if test="description != null">#{description},</if>
            <if test="reporterName != null and reporterName != ''">#{reporterName},</if>
            <if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
            <if test="images != null">#{images},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDormRepairRequest" parameterType="DormRepairRequest">
        update dorm_repair_request
        <trim prefix="SET" suffixOverrides=",">
            <if test="requestNo != null and requestNo != ''">request_no = #{requestNo},</if>
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="dormId != null">dorm_id = #{dormId},</if>
            <if test="specialty != null and specialty != ''">specialty = #{specialty},</if>
            <if test="description != null">description = #{description},</if>
            <if test="reporterName != null and reporterName != ''">reporter_name = #{reporterName},</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone = #{contactPhone},</if>
            <if test="images != null">images = #{images},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where request_id = #{requestId}
    </update>

    <delete id="deleteDormRepairRequestByRequestId" parameterType="Long">
        delete from dorm_repair_request where request_id = #{requestId}
    </delete>

    <delete id="deleteDormRepairRequestByRequestIds" parameterType="String">
        delete from dorm_repair_request where request_id in 
        <foreach item="requestId" collection="array" open="(" separator="," close=")">
            #{requestId}
        </foreach>
    </delete>
</mapper>